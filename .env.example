# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Supabase (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# LLM Provider - Choose ONE (priority order):
# 1. DeepSeek Official (recommended for DeepSeek models) - Get from https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 2. OpenAI (fallback) - Get from https://platform.openai.com
# OPENAI_API_KEY=sk-your-openai-key

# 3. NVIDIA (original - may have network issues)
# NVIDIA_API_KEY=nvapi-your-nvidia-key

# Optional: Webhook URL for production (set after deploy)
WEBHOOK_URL=https://your-app.onrender.com/webhook

# Local dev port
PORT=5000